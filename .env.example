# Atlas connection string (preferred). Do not commit real credentials.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/
MONGODB_DATABASE=agentcircle
# Tests use mongomock via conftest; leave false for local/dev against Atlas.
USE_MOCK_MONGODB=false
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# Auth. This exact value is REFUSED at startup when the app points at a remote
# database — anyone who has read the repo could forge a session with it. Generate
# your own (must be at least 32 bytes):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me

# Embeddings. "local" is a deterministic hash stand-in that needs no network and is
# NOT semantically meaningful — it matches shared vocabulary, not shared meaning.
# Voyage is MongoDB's own embedding model and is the intended production setting.
# Voyage is MongoDB's own embedding model family. The voyage-4 series (voyage-4-large,
# voyage-4, voyage-4-lite, voyage-4-nano) supports 256/512/1024/2048 dims, 1024 default,
# and all share one embedding space — so moving within the series needs no re-embed.
# The key must be a Voyage key from dash.voyageai.com (starts with "pa-"); an Atlas key
# is rejected by the Voyage endpoint with 403.
#
# Two doors onto the same Voyage models:
#   EMBEDDING_PROVIDER=voyage   + VOYAGE_API_KEY        (api.voyageai.com, "pa-" key)
#   EMBEDDING_PROVIDER=mongodb  + MONGODB_AI_API_KEY    (ai.mongodb.com, billed to Atlas)
# They share one vector space, so switching between them needs NO re-embed. Photo search
# (voyage-multimodal-3.5) always uses VOYAGE_API_KEY directly — MongoDB's automated
# embedding does not cover multimodal.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIMENSIONS=1024
VOYAGE_API_KEY=
MONGODB_AI_API_KEY=

# EMBEDDING_PROVIDER picks the door for ALL Voyage-family calls — embeddings, reranking
# and photo search — because they share one per-minute quota per account. Splitting them
# across two accounts means ordinary search traffic starves the reranker.
#
# Reranking is one API call per search. Off, discovery still works but ordering is
# coarser and match_percent clusters (99/98/98) instead of spreading (99/75/75); the UI
# reports Rerank: off so nothing pretends otherwise.
RERANK_ENABLED=true
RERANK_MODEL=rerank-2.5

# Atlas Search / Vector Search. Index availability is detected at startup, not
# configured — $search against a missing index returns an empty result set rather than
# raising, so a flag would only let the app lie about which path served a query.
# Changing the embedding dimension invalidates every stored vector and index:
#   1. set EMBEDDING_PROVIDER + the key above
#   2. uv run python -m scripts.reembed
#   3. uv run python -m scripts.create_search_indexes --recreate --wait 300
# Free-tier clusters cap search indexes at 3; the app falls back to local scoring when
# one is missing and reports which path it used.

# LangChain agent runtime. All three providers speak the OpenAI wire format but name
# models differently, and LLM_MODEL must match the provider you pick:
#
#   openrouter  <vendor>/<model>                  e.g. openai/gpt-4o-mini
#   openai      <model>                           e.g. gpt-4o-mini
#   fireworks   accounts/fireworks/models/<name>  e.g. accounts/fireworks/models/kimi-k2-instruct
#
# A mismatched id fails at request time, and because the agent layer falls back on
# error you would just see everything running in fallback. GET /api/runtime/status
# reports the mismatch under "warnings".
#
# Whichever you choose, the model MUST support function calling / structured output —
# persona extraction, community comments, and negotiation all use structured output
# and will fall back on any model that lacks it.
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini

# Set the key for the provider above. If LLM_PROVIDER's key is empty, the runtime
# falls back to whichever other provider key is present.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
FIREWORKS_API_KEY=
# Or set LLM_API_KEY to use LLM_PROVIDER's endpoint with an arbitrary key.
LLM_API_KEY=
LLM_BASE_URL=

AGENT_FALLBACK_ENABLED=true
AGENT_TIMEOUT_SECONDS=45

# Deep research (Exa). Optional — with no key the surface reports itself off rather
# than degrading, because a "brief" assembled from nothing is worse than no brief.
# Exa returns its own costDollars per call, and the daily budget is enforced against
# that real number rather than an estimate. Get a key at dashboard.exa.ai.
EXA_API_KEY=
RESEARCH_DAILY_BUDGET_USD=1.0

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentcircle

# ---------------------------------------------------------------------------
# Demo accounts
# ---------------------------------------------------------------------------
# Not configuration — documentation. These are created by:
#
#   cd backend && uv run python -m scripts.seed_users        # add missing ones
#   cd backend && uv run python -m scripts.seed_users --reset  # delete and recreate
#
# They go through the ordinary signup path (password hashing, ingestion, chunking,
# embedding, persona extraction), so anything that works for them works for a real
# account. The password is a constant in scripts/seed_users.py, not read from here.
#
#   Password for all five:  agentcircle
#
#   kenji@example.com   Kenji Tanaka    infrastructure / streaming    @kenji_tanaka
#   maya@example.com    Maya Chen       founder, B2B onboarding       @maya_chen
#   sofia@example.com   Sofia Alvarez   research engineer             @sofia_alvarez
#   elena@example.com   Elena Rossi     clinical operations           @elena_rossi
#   priya@example.com   Priya Raman     payments / ledgers            @priya_raman
#
# Kenji is the reference account — the only one where a whole path works end to end.
# He has 3 persona sources (~1,450 characters) against everyone else's 1, the only
# indexed photos on the cluster, and interview + photo search + research all enabled.
# He is also the top result for "backpressure and replay in a streaming pipeline",
# which makes him the subject to search FOR.
#
# Sign in as Maya to DRIVE a demo: she has the most feed activity and is one of the
# few with community comments enabled. Kenji's comment_enabled is off, so he cannot
# be recruited into a community thread.
#
# Consent flags are per-account and deliberately not uniform — a refusal is a feature
# here, so some surfaces decline on purpose. Check MY AGENT for the live state, or:
#   db.member_settings.find({}, {discoverable:1, comment_enabled:1, interview_enabled:1})
#
# These accounts only exist in databases you seeded. A fresh cluster has none until
# you run the command above.
